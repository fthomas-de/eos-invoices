msgid "Invoices"
msgstr "Счета"

#: forms.py:78
msgid "Not installed"
msgstr "Не установлено"

#: forms.py:160 models.py:27 templates/eos_invoices/base.html:28
#: templates/eos_invoices/settings.html:8 tests/test_translations.py:18
msgctxt "EVE jargon"
msgid "Alliance"
msgstr "Alliance"

#: models.py:35
msgid ""
"Only Corporations in this Alliance see their outstanding payments. Without "
"an Alliance nobody sees anything."
msgstr ""
"Только Corporation из этой Alliance видят свои неоплаченные платежи. Без "
"Alliance никто ничего не видит."

#: models.py:42 models.py:45
msgid "Configuration"
msgstr "Конфигурация"

#: models.py:57
msgid "Field is true"
msgstr "Поле истинно"

#: models.py:58
msgid "Field is not empty"
msgstr "Поле не пустое"

#: models.py:59
msgid "Field equals value"
msgstr "Поле равно значению"

#: models.py:61 templates/eos_invoices/sources.html:28
msgid "Name"
msgstr "Название"

#: models.py:62
msgid "Enabled"
msgstr "Включено"

#: models.py:64 templates/eos_invoices/sources.html:29
msgid "Model"
msgstr "Модель"

#: models.py:66
msgid "The model holding one row per payment, as app_label.ModelName."
msgstr ""
"Модель, содержащая одну строку на каждый платёж, в формате "
"app_label.ModelName."

#: models.py:69
msgid "Corporation ID field"
msgstr "Поле ID Corporation"

#: models.py:72
msgid ""
"Field holding the EVE Corporation ID, e.g. corp_id or "
"corporation__corporation_id."
msgstr ""
"Поле с ID Corporation в EVE, например corp_id или "
"corporation__corporation_id."

#: models.py:77
msgid "Amount field"
msgstr "Поле суммы"

#: models.py:79
msgid "Field holding the amount owed in ISK."
msgstr "Поле с суммой долга в ISK."

#: models.py:82
msgid "Paid field"
msgstr "Поле оплаты"

#: models.py:84
msgid "Field that tells whether a payment has been made."
msgstr "Поле, показывающее, был ли произведён платёж."

#: models.py:87
msgid "Paid when"
msgstr "Оплачено, если"

#: models.py:93
msgid "Paid value"
msgstr "Значение оплаты"

#: models.py:96
msgid "Only for \"Field equals value\": the value that means paid."
msgstr "Только для «Поле равно значению»: значение, означающее оплату."

#: models.py:99 models.py:170 templates/eos_invoices/admin.html:50
#: templates/eos_invoices/index.html:69 templates/eos_invoices/log.html:22
#: tests/test_translations.py:19
msgctxt "EVE jargon"
msgid "Reason"
msgstr "Reason"

#: models.py:103
#, python-brace-format
msgid ""
"Reason to enter with the payment in game. Field names in braces are replaced"
" by their values, with an optional format: {corp_id}/{month:02d}/{year}"
msgstr ""
"Reason, который указывается при платеже в игре. Имена полей в фигурных "
"скобках заменяются их значениями, формат необязателен: "
"{corp_id}/{month:02d}/{year}"

#: models.py:109 models.py:171 templates/eos_invoices/admin.html:48
#: templates/eos_invoices/index.html:67 templates/eos_invoices/log.html:20
msgid "Description"
msgstr "Описание"

#: models.py:113
#, python-brace-format
msgid ""
"What a row is for, shown next to the amount. Same placeholders as the "
"reason, e.g. {month:02d}/{year}"
msgstr ""
"Назначение строки, показывается рядом с суммой. Те же заполнители, что и в "
"Reason, например {month:02d}/{year}"

#: models.py:118
msgid "Date field"
msgstr "Поле даты"

#: models.py:121
msgid "Optional date or datetime field; rows are sorted by it, newest first."
msgstr ""
"Необязательное поле даты или даты-времени; строки сортируются по нему, "
"сначала новые."

#: models.py:125 templates/eos_invoices/index.html:45
msgid "Pay to"
msgstr "Платить"

#: models.py:132
msgid ""
"The Corporation that receives the ISK. Lists the Corporations of the "
"Alliance chosen on the Alliance tab."
msgstr ""
"Corporation, получающая ISK. В списке — Corporation из Alliance, выбранной "
"на вкладке Alliance."

#: models.py:140
msgid "Payment source"
msgstr "Источник платежей"

#: models.py:141 templates/eos_invoices/sources.html:8
msgid "Payment sources"
msgstr "Источники платежей"

#: models.py:155 templates/eos_invoices/admin.html:47
#: templates/eos_invoices/index.html:66 templates/eos_invoices/log.html:16
msgid "Date"
msgstr "Дата"

#: models.py:159 templates/eos_invoices/log.html:17
msgid "Marked by"
msgstr "Отметил"

#: models.py:163 templates/eos_invoices/log.html:18
msgid "Source"
msgstr "Источник"

#: models.py:164 templates/eos_invoices/log.html:23
msgid "Row"
msgstr "Строка"

#: models.py:165
msgid "Corporation ID"
msgstr "ID Corporation"

#: models.py:167 templates/eos_invoices/log.html:19
msgctxt "EVE jargon"
msgid "Corporation"
msgstr "Corporation"

#: models.py:169 templates/eos_invoices/admin.html:49
#: templates/eos_invoices/index.html:68 templates/eos_invoices/log.html:21
msgid "Amount"
msgstr "Сумма"

#: models.py:176
msgid "Payment log entry"
msgstr "Запись журнала"

#: models.py:177
msgid "Payment log"
msgstr "Журнал платежей"

#: overview.py:45
msgid "You have no main character."
msgstr "У вас нет Main-персонажа."

#: overview.py:54 overview.py:113
msgid "No Alliance has been configured for this app yet."
msgstr "Для этого приложения ещё не настроена Alliance."

#: overview.py:59
#, python-format
msgid "%(corporation)s is not a member of %(alliance)s."
msgstr "%(corporation)s не состоит в %(alliance)s."

#: overview.py:138
#, python-format
msgid "More than %(limit)s open payments; only the newest are shown."
msgstr "Более %(limit)s неоплаченных платежей; показаны только самые новые."

#: sources.py:90
#, python-format
msgid "Unknown model %(label)s."
msgstr "Неизвестная модель %(label)s."

#: sources.py:114
#, python-format
msgid "Invalid field name %(name)s."
msgstr "Недопустимое имя поля %(name)s."

#: sources.py:120
#, python-format
msgid "%(model)s has no field %(field)s. Available: %(fields)s"
msgstr "У %(model)s нет поля %(field)s. Доступны: %(fields)s"

#: sources.py:131
#, python-format
msgid "%(field)s is not a relation and cannot be followed."
msgstr "%(field)s не является связью, по нему нельзя перейти."

#: sources.py:138
#, python-format
msgid "%(field)s points at many rows; only single relations can be followed."
msgstr ""
"%(field)s указывает на множество строк; переходить можно только по одиночным"
" связям."

#: sources.py:145
#, python-format
msgid ""
"%(path)s ends at a relation. Name a field on it, e.g. %(path)s__%(example)s."
msgstr ""
"%(path)s заканчивается на связи. Укажите её поле, например "
"%(path)s__%(example)s."

#: sources.py:221
#, python-format
msgid "Malformed template: %(error)s"
msgstr "Некорректный шаблон: %(error)s"

#: sources.py:229
#, python-format
msgid ""
"Invalid placeholder {%(name)s}. Use a field name with an optional format."
msgstr ""
"Недопустимый заполнитель {%(name)s}. Используйте имя поля с необязательным "
"форматом."

#: sources.py:259
msgid "The Corporation ID field must be an integer field."
msgstr "Поле ID Corporation должно быть целочисленным."

#: sources.py:260
msgid "The amount field must be a number field."
msgstr "Поле суммы должно быть числовым."

#: sources.py:261
msgid "\"Field is true\" needs a boolean field."
msgstr "«Поле истинно» требует логического поля."

#: sources.py:262
msgid "The date field must be a date or datetime field."
msgstr "Поле даты должно быть полем даты или даты-времени."

#: sources.py:281
msgid "Enter the value that means paid."
msgstr "Укажите значение, означающее оплату."

#: sources.py:402 sources.py:404
msgid "The payment no longer exists."
msgstr "Этот платёж больше не существует."

#: sources.py:452
msgid "Rows of this source cannot be marked as paid here."
msgstr "Строки этого источника нельзя отметить здесь как оплаченные."

#: sources.py:456
msgid "This payment is already marked as paid."
msgstr "Этот платёж уже отмечен как оплаченный."

#: templates/eos_invoices/admin.html:17 templates/eos_invoices/index.html:13
msgid "Outstanding"
msgstr "К оплате"

#: templates/eos_invoices/admin.html:22
#, python-format
msgid "%(counter)s Corporation with nothing outstanding"
msgid_plural "%(counter)s Corporations with nothing outstanding"
msgstr[0] "%(counter)s Corporation без задолженностей"
msgstr[1] "%(counter)s Corporation без задолженностей"
msgstr[2] "%(counter)s Corporation без задолженностей"

#: templates/eos_invoices/admin.html:67
msgid "Mark this payment as paid?"
msgstr "Отметить этот платёж как оплаченный?"

#: templates/eos_invoices/admin.html:72
msgid "Mark as paid"
msgstr "Отметить как оплаченный"

#: templates/eos_invoices/admin.html:86 templates/eos_invoices/index.html:60
msgid "Nothing outstanding."
msgstr "Задолженностей нет."

#: templates/eos_invoices/base.html:9 tests/test_translations.py:13
msgid "Overview"
msgstr "Обзор"

#: templates/eos_invoices/base.html:16
msgid "All Corporations"
msgstr "Все Corporation"

#: templates/eos_invoices/base.html:20
msgid "Log"
msgstr "Журнал"

#: templates/eos_invoices/base.html:24
msgid "Sources"
msgstr "Источники"

#: templates/eos_invoices/index.html:20
msgid "Outstanding only"
msgstr "Только неоплаченные"

#: templates/eos_invoices/index.html:23
msgid "Including paid"
msgstr "Включая оплаченные"

#: templates/eos_invoices/index.html:54
msgid "This source cannot be read at the moment."
msgstr "Этот источник сейчас недоступен для чтения."

#: templates/eos_invoices/index.html:70 templates/eos_invoices/sources.html:30
msgid "Status"
msgstr "Статус"

#: templates/eos_invoices/index.html:94
msgid "Paid"
msgstr "Оплачено"

#: templates/eos_invoices/index.html:96
msgid "Open"
msgstr "Открыто"

#: templates/eos_invoices/index.html:108
#: templates/eos_invoices/sources.html:76
msgid "No payment sources are configured."
msgstr "Источники платежей не настроены."

#: templates/eos_invoices/log.html:7
