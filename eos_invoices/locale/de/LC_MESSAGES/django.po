#: models.py:87
msgid "Paid when"
msgstr "Bezahlt, wenn"

#: models.py:93
msgid "Paid value"
msgstr "Wert für bezahlt"

#: models.py:96
msgid "Only for \"Field equals value\": the value that means paid."
msgstr "Nur für „Feld entspricht Wert“: der Wert, der bezahlt bedeutet."

#: models.py:99 models.py:192 templates/eos_invoices/admin.html:83
