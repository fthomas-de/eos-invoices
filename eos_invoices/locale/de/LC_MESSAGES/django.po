msgid "Invoices"
msgstr "Rechnungen"

#: forms.py:78
msgid "Not installed"
msgstr "Nicht installiert"

#: forms.py:159 models.py:26 templates/eos_invoices/base.html:20
#: templates/eos_invoices/settings.html:8 tests/test_translations.py:18
msgctxt "EVE jargon"
msgid "Alliance"
msgstr "Alliance"

#: models.py:34
msgid ""
"Only Corporations in this Alliance see their outstanding payments. Without "
"an Alliance nobody sees anything."
msgstr ""
"Nur Corporations dieser Alliance sehen ihre offenen Zahlungen. Ohne Alliance"
" sieht niemand etwas."

#: models.py:41 models.py:44
msgid "Configuration"
msgstr "Konfiguration"

#: models.py:56
msgid "Field is true"
msgstr "Feld ist wahr"

#: models.py:57
msgid "Field is not empty"
msgstr "Feld ist nicht leer"

#: models.py:58
msgid "Field equals value"
msgstr "Feld entspricht Wert"

#: models.py:60 templates/eos_invoices/sources.html:28
msgid "Name"
msgstr "Name"

#: models.py:61
msgid "Enabled"
msgstr "Aktiv"

#: models.py:63 templates/eos_invoices/sources.html:29
msgid "Model"
msgstr "Modell"

#: models.py:65
msgid "The model holding one row per payment, as app_label.ModelName."
msgstr "Das Modell mit einer Zeile pro Zahlung, als app_label.ModelName."

#: models.py:68
msgid "Corporation ID field"
msgstr "Feld Corporation-ID"

#: models.py:71
msgid ""
"Field holding the EVE Corporation ID, e.g. corp_id or "
"corporation__corporation_id."
msgstr ""
"Feld mit der EVE-Corporation-ID, z. B. corp_id oder "
"corporation__corporation_id."

#: models.py:76
msgid "Amount field"
msgstr "Feld Betrag"

#: models.py:78
msgid "Field holding the amount owed in ISK."
msgstr "Feld mit dem geschuldeten Betrag in ISK."

#: models.py:81
msgid "Paid field"
msgstr "Feld Bezahlt"

#: models.py:83
msgid "Field that tells whether a payment has been made."
msgstr "Feld, das angibt, ob eine Zahlung erfolgt ist."

#: models.py:86
msgid "Paid when"
msgstr "Bezahlt, wenn"

#: models.py:92
msgid "Paid value"
msgstr "Wert für bezahlt"

#: models.py:95
msgid "Only for \"Field equals value\": the value that means paid."
msgstr "Nur für „Feld entspricht Wert“: der Wert, der bezahlt bedeutet."

#: models.py:98 templates/eos_invoices/index.html:69
#: tests/test_translations.py:19
msgctxt "EVE jargon"
msgid "Reason"
msgstr "Reason"

#: models.py:102
#, python-brace-format
msgid ""
"Reason to enter with the payment in game. Field names in braces are replaced"
" by their values, with an optional format: {corp_id}/{month:02d}/{year}"
msgstr ""
"Reason, der bei der Zahlung im Spiel angegeben wird. Feldnamen in "
"geschweiften Klammern werden durch ihre Werte ersetzt, optional mit Format: "
"{corp_id}/{month:02d}/{year}"

#: models.py:108 templates/eos_invoices/index.html:67
msgid "Description"
msgstr "Beschreibung"

#: models.py:112
#, python-brace-format
msgid ""
"What a row is for, shown next to the amount. Same placeholders as the "
"reason, e.g. {month:02d}/{year}"
msgstr ""
"Wofür eine Zeile steht, angezeigt neben dem Betrag. Dieselben Platzhalter "
"wie beim Reason, z. B. {month:02d}/{year}"

#: models.py:117
msgid "Date field"
msgstr "Feld Datum"

#: models.py:120
msgid "Optional date or datetime field; rows are sorted by it, newest first."
msgstr ""
"Optionales Datums- oder Zeitstempelfeld; die Zeilen werden danach sortiert, "
"neueste zuerst."

#: models.py:124 templates/eos_invoices/index.html:45
msgid "Pay to"
msgstr "Zahlen an"

#: models.py:131
msgid ""
"The Corporation that receives the ISK. Lists the Corporations of the "
"Alliance chosen on the Alliance tab."
msgstr ""
"Die Corporation, die die ISK erhält. Zur Auswahl stehen die Corporations der"
" Alliance, die im Tab Alliance gewählt ist."

#: models.py:139
msgid "Payment source"
msgstr "Zahlungsquelle"

#: models.py:140 templates/eos_invoices/sources.html:8
msgid "Payment sources"
msgstr "Zahlungsquellen"

#: overview.py:37
msgid "You have no main character."
msgstr "Du hast keinen Main Character."

#: overview.py:46
msgid "No Alliance has been configured for this app yet."
msgstr "Für diese App wurde noch keine Alliance eingerichtet."

#: overview.py:51
#, python-format
msgid "%(corporation)s is not a member of %(alliance)s."
msgstr "%(corporation)s ist kein Mitglied von %(alliance)s."

#: sources.py:87
#, python-format
msgid "Unknown model %(label)s."
msgstr "Unbekanntes Modell %(label)s."

#: sources.py:111
#, python-format
msgid "Invalid field name %(name)s."
msgstr "Ungültiger Feldname %(name)s."

#: sources.py:117
#, python-format
msgid "%(model)s has no field %(field)s. Available: %(fields)s"
msgstr "%(model)s hat kein Feld %(field)s. Vorhanden: %(fields)s"

#: sources.py:128
#, python-format
msgid "%(field)s is not a relation and cannot be followed."
msgstr "%(field)s ist keine Relation und kann nicht verfolgt werden."

#: sources.py:135
#, python-format
msgid "%(field)s points at many rows; only single relations can be followed."
msgstr ""
"%(field)s verweist auf viele Zeilen; nur Einzelrelationen können verfolgt "
"werden."

#: sources.py:142
#, python-format
msgid ""
"%(path)s ends at a relation. Name a field on it, e.g. %(path)s__%(example)s."
msgstr ""
"%(path)s endet an einer Relation. Gib ein Feld darauf an, z. B. "
"%(path)s__%(example)s."

#: sources.py:218
#, python-format
msgid "Malformed template: %(error)s"
msgstr "Fehlerhafte Vorlage: %(error)s"

#: sources.py:226
#, python-format
msgid ""
"Invalid placeholder {%(name)s}. Use a field name with an optional format."
msgstr ""
"Ungültiger Platzhalter {%(name)s}. Verwende einen Feldnamen mit optionalem "
"Format."

#: sources.py:256
msgid "The Corporation ID field must be an integer field."
msgstr "Das Feld Corporation-ID muss ein Ganzzahlfeld sein."

#: sources.py:257
msgid "The amount field must be a number field."
msgstr "Das Feld Betrag muss ein Zahlenfeld sein."

#: sources.py:258
msgid "\"Field is true\" needs a boolean field."
msgstr "„Feld ist wahr“ braucht ein boolesches Feld."

#: sources.py:259
msgid "The date field must be a date or datetime field."
msgstr "Das Feld Datum muss ein Datums- oder Zeitstempelfeld sein."

#: sources.py:278
msgid "Enter the value that means paid."
msgstr "Gib den Wert an, der bezahlt bedeutet."

#: templates/eos_invoices/base.html:9 tests/test_translations.py:13
msgid "Overview"
msgstr "Übersicht"

#: templates/eos_invoices/base.html:16
msgid "Sources"
msgstr "Quellen"

#: templates/eos_invoices/index.html:13
msgid "Outstanding"
msgstr "Offen"

#: templates/eos_invoices/index.html:20
msgid "Outstanding only"
msgstr "Nur offene"

#: templates/eos_invoices/index.html:23
msgid "Including paid"
msgstr "Inklusive bezahlte"

#: templates/eos_invoices/index.html:54
msgid "This source cannot be read at the moment."
msgstr "Diese Quelle kann derzeit nicht gelesen werden."

#: templates/eos_invoices/index.html:60
msgid "Nothing outstanding."
msgstr "Nichts offen."

#: templates/eos_invoices/index.html:66
msgid "Date"
msgstr "Datum"

#: templates/eos_invoices/index.html:68
msgid "Amount"
msgstr "Betrag"

#: templates/eos_invoices/index.html:70 templates/eos_invoices/sources.html:30
msgid "Status"
msgstr "Status"

#: templates/eos_invoices/index.html:94
msgid "Paid"
msgstr "Bezahlt"

#: templates/eos_invoices/index.html:96
msgid "Open"
msgstr "Offen"

#: templates/eos_invoices/index.html:108
#: templates/eos_invoices/sources.html:76
msgid "No payment sources are configured."
msgstr "Es sind keine Zahlungsquellen eingerichtet."

#: templates/eos_invoices/partials/copy-button.html:6
msgid "Copy"
msgstr "Kopieren"

#: templates/eos_invoices/settings.html:19
#: templates/eos_invoices/source_form.html:51
msgid "Save"
msgstr "Speichern"

#: templates/eos_invoices/source_form.html:10
#: templates/eos_invoices/sources.html:10
msgid "Add source"
msgstr "Quelle hinzufügen"

#: templates/eos_invoices/source_form.html:29
msgid "Fields"
msgstr "Felder"

#: templates/eos_invoices/source_form.html:31
msgid ""
"Field names of the chosen model. Related models are reached with a double "
"underscore, as in a Django query."
msgstr ""
"Feldnamen des gewählten Modells. Verknüpfte Modelle erreicht man mit "
"doppeltem Unterstrich, wie in einer Django-Abfrage."

#: templates/eos_invoices/source_form.html:43
msgid "Display"
msgstr "Anzeige"

#: templates/eos_invoices/source_form.html:52
msgid "Cancel"
msgstr "Abbrechen"

#: templates/eos_invoices/sources.html:16
msgid ""
"Each source is a model of another app with one row per payment a Corporation"
" owes. The overview reads every enabled source for the Corporation of the "
"viewer's main character."
msgstr ""
"Jede Quelle ist ein Modell einer anderen App mit einer Zeile pro Zahlung, "
"die eine Corporation schuldet. Die Übersicht liest jede aktive Quelle für "
"die Corporation des Main Characters des Betrachters."

#: templates/eos_invoices/sources.html:40
msgid "Disabled"
msgstr "Deaktiviert"

#: templates/eos_invoices/sources.html:50
#, python-format
msgid "%(counter)s row"
msgid_plural "%(counter)s rows"
msgstr[0] "%(counter)s Zeile"
msgstr[1] "%(counter)s Zeilen"

#: templates/eos_invoices/sources.html:63
#, python-format
msgid "Delete %(name)s?"
msgstr "%(name)s löschen?"

#: views.py:58
#, python-format
msgid "Saved %(name)s."
msgstr "%(name)s gespeichert."

#: views.py:95
#, python-format
msgid "Deleted %(name)s."
msgstr "%(name)s gelöscht."

#: views.py:108
msgid "Settings saved."
msgstr "Einstellungen gespeichert."
