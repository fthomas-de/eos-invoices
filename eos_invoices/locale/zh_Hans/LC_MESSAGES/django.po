#: tests/test_translations.py:37
msgctxt "EVE jargon"
msgid "Reason"
msgstr "Reason"

#: models.py:103
#, python-brace-format
msgid ""
"Reason to enter with the payment in game. Field names in braces are replaced"
" by their values, with an optional format: {corp_id}/{month:02d}/{year}"
msgstr "游戏内付款时填写的 Reason。花括号中的字段名会被替换为其值，可选格式：{corp_id}/{month:02d}/{year}"

#: models.py:109 models.py:193 templates/eos_invoices/admin.html:81
#: templates/eos_invoices/index.html:69 templates/eos_invoices/log.html:24
msgid "Description"
msgstr "描述"

#: models.py:113
#, python-brace-format
msgid ""
"What a row is for, shown next to the amount. Same placeholders as the "
"reason, e.g. {month:02d}/{year}"
msgstr "该行的用途，显示在金额旁。占位符与 Reason 相同，例如 {month:02d}/{year}"

#: models.py:118
msgid "Date field"
msgstr "日期字段"

#: models.py:121
msgid "Optional date or datetime field; rows are sorted by it, newest first."
msgstr "可选的日期或日期时间字段；按其排序，最新的在前。"

#: models.py:124
msgid "Month field"
msgstr "月份字段"

#: models.py:128
msgid ""
"Optional integer field (1-12) holding the row's month. Together with the "
"Year field below, hides the Reason while the row is for the month still in "
"progress - the amount owed for it can still change. Both fields are required"
" for this; set alone, this one does nothing."
msgstr ""
"可选的整数字段（1-12），存放该行的月份。与下方的年份字段一起使用时，会在该行所属月份仍在进行中时隐藏 Reason —— "
"因为该月应付金额仍可能变化。需要同时设置两个字段；仅设置此字段不会生效。"

#: models.py:136
msgid "Year field"
msgstr "年份字段"

#: models.py:140
msgid ""
"Optional integer field holding the row's year, e.g. 2026. Used together with"
" the Month field above - a month number alone cannot tell this year's row "
"from the same month a year ago."
msgstr "可选的整数字段，存放该行的年份，例如 2026。需与上方的月份字段配合使用 —— 仅凭月份数字无法区分本年度的行与去年同月的行。"

#: models.py:147 templates/eos_invoices/index.html:47
msgid "Pay to"
msgstr "付款给"

#: models.py:154
msgid ""
"The Corporation that receives the ISK. Lists the Corporations of the "
"Alliance chosen on the Alliance tab."
msgstr "接收 ISK 的 Corporation。列表为 Alliance 标签页中所选 Alliance 的各个 Corporation。"

