#: auth_hooks.py:13 templates/eos_invoices/base.html:4
#: templates/eos_invoices/base.html:27
msgid "Invoices"
msgstr "账单"

#: forms.py:78
msgid "Not installed"
msgstr "未安装"

#: forms.py:159 models.py:26 templates/eos_invoices/base.html:20
#: templates/eos_invoices/settings.html:8 tests/test_translations.py:18
msgctxt "EVE jargon"
msgid "Alliance"
msgstr "Alliance"

#: models.py:34
msgid ""
"Only Corporations in this Alliance see their outstanding payments. Without "
"an Alliance nobody sees anything."
msgstr "只有此 Alliance 中的 Corporation 能看到其未付款项。未设置 Alliance 时，任何人都看不到内容。"

#: models.py:41 models.py:44
msgid "Configuration"
msgstr "配置"

#: models.py:56
msgid "Field is true"
msgstr "字段为真"

#: models.py:57
msgid "Field is not empty"
msgstr "字段不为空"

#: models.py:58
msgid "Field equals value"
msgstr "字段等于指定值"

#: models.py:60 templates/eos_invoices/sources.html:28
msgid "Name"
msgstr "名称"

#: models.py:61
msgid "Enabled"
msgstr "已启用"

#: models.py:63 templates/eos_invoices/sources.html:29
msgid "Model"
msgstr "模型"

#: models.py:65
msgid "The model holding one row per payment, as app_label.ModelName."
msgstr "每笔款项占一行的模型，格式为 app_label.ModelName。"

#: models.py:68
msgid "Corporation ID field"
msgstr "Corporation ID 字段"

#: models.py:71
msgid ""
"Field holding the EVE Corporation ID, e.g. corp_id or "
"corporation__corporation_id."
msgstr "存放 EVE Corporation ID 的字段，例如 corp_id 或 corporation__corporation_id。"

#: models.py:76
msgid "Amount field"
msgstr "金额字段"

#: models.py:78
msgid "Field holding the amount owed in ISK."
msgstr "存放应付 ISK 金额的字段。"

#: models.py:81
msgid "Paid field"
msgstr "已付字段"

#: models.py:83
msgid "Field that tells whether a payment has been made."
msgstr "表示是否已付款的字段。"

#: models.py:86
msgid "Paid when"
msgstr "已付条件"

#: models.py:92
msgid "Paid value"
msgstr "已付值"

#: models.py:95
msgid "Only for \"Field equals value\": the value that means paid."
msgstr "仅用于“字段等于指定值”：表示已付的值。"

#: models.py:98 templates/eos_invoices/index.html:69
#: tests/test_translations.py:19
msgctxt "EVE jargon"
msgid "Reason"
msgstr "Reason"

#: models.py:102
#, python-brace-format
msgid ""
"Reason to enter with the payment in game. Field names in braces are replaced"
" by their values, with an optional format: {corp_id}/{month:02d}/{year}"
msgstr "游戏内付款时填写的 Reason。花括号中的字段名会被替换为其值，可选格式：{corp_id}/{month:02d}/{year}"

#: models.py:108 templates/eos_invoices/index.html:67
msgid "Description"
msgstr "描述"

#: models.py:112
#, python-brace-format
msgid ""
"What a row is for, shown next to the amount. Same placeholders as the "
"reason, e.g. {month:02d}/{year}"
msgstr "该行的用途，显示在金额旁。占位符与 Reason 相同，例如 {month:02d}/{year}"

#: models.py:117
msgid "Date field"
msgstr "日期字段"

#: models.py:120
msgid "Optional date or datetime field; rows are sorted by it, newest first."
msgstr "可选的日期或日期时间字段；按其排序，最新的在前。"

#: models.py:124 templates/eos_invoices/index.html:45
msgid "Pay to"
msgstr "付款给"

#: models.py:131
msgid ""
"The Corporation that receives the ISK. Lists the Corporations of the "
"Alliance chosen on the Alliance tab."
msgstr "接收 ISK 的 Corporation。列表为 Alliance 标签页中所选 Alliance 的各个 Corporation。"

#: models.py:139
msgid "Payment source"
msgstr "款项来源"

#: models.py:140 templates/eos_invoices/sources.html:8
msgid "Payment sources"
msgstr "款项来源"

#: overview.py:37
msgid "You have no main character."
msgstr "你没有 Main 角色。"

#: overview.py:46
msgid "No Alliance has been configured for this app yet."
msgstr "此应用尚未配置 Alliance。"

#: overview.py:51
#, python-format
msgid "%(corporation)s is not a member of %(alliance)s."
msgstr "%(corporation)s 不是 %(alliance)s 的成员。"

#: sources.py:87
#, python-format
msgid "Unknown model %(label)s."
msgstr "未知模型 %(label)s。"

#: sources.py:111
#, python-format
msgid "Invalid field name %(name)s."
msgstr "无效的字段名 %(name)s。"

#: sources.py:117
#, python-format
msgid "%(model)s has no field %(field)s. Available: %(fields)s"
msgstr "%(model)s 没有字段 %(field)s。可用字段：%(fields)s"

#: sources.py:128
#, python-format
msgid "%(field)s is not a relation and cannot be followed."
msgstr "%(field)s 不是关联字段，无法继续访问。"

#: sources.py:135
#, python-format
msgid "%(field)s points at many rows; only single relations can be followed."
msgstr "%(field)s 指向多行；只能访问单一关联。"

#: sources.py:142
#, python-format
msgid ""
"%(path)s ends at a relation. Name a field on it, e.g. %(path)s__%(example)s."
msgstr "%(path)s 止于一个关联。请指定其字段，例如 %(path)s__%(example)s。"

#: sources.py:218
#, python-format
msgid "Malformed template: %(error)s"
msgstr "模板格式错误：%(error)s"

#: sources.py:226
#, python-format
msgid ""
"Invalid placeholder {%(name)s}. Use a field name with an optional format."
msgstr "无效的占位符 {%(name)s}。请使用字段名，可附加格式。"

#: sources.py:256
msgid "The Corporation ID field must be an integer field."
msgstr "Corporation ID 字段必须是整数字段。"

#: sources.py:257
msgid "The amount field must be a number field."
msgstr "金额字段必须是数字字段。"

#: sources.py:258
msgid "\"Field is true\" needs a boolean field."
msgstr "“字段为真”需要布尔字段。"

#: sources.py:259
msgid "The date field must be a date or datetime field."
msgstr "日期字段必须是日期或日期时间字段。"

#: sources.py:278
msgid "Enter the value that means paid."
msgstr "请输入表示已付的值。"

#: templates/eos_invoices/base.html:9 tests/test_translations.py:13
msgid "Overview"
msgstr "概览"

#: templates/eos_invoices/base.html:16
msgid "Sources"
msgstr "来源"

#: templates/eos_invoices/index.html:13
msgid "Outstanding"
msgstr "未付"

#: templates/eos_invoices/index.html:20
msgid "Outstanding only"
msgstr "仅未付"

#: templates/eos_invoices/index.html:23
msgid "Including paid"
msgstr "包括已付"

#: templates/eos_invoices/index.html:54
msgid "This source cannot be read at the moment."
msgstr "此来源暂时无法读取。"

#: templates/eos_invoices/index.html:60
msgid "Nothing outstanding."
msgstr "没有未付款项。"

#: templates/eos_invoices/index.html:66
msgid "Date"
msgstr "日期"

#: templates/eos_invoices/index.html:68
msgid "Amount"
msgstr "金额"

#: templates/eos_invoices/index.html:70 templates/eos_invoices/sources.html:30
msgid "Status"
msgstr "状态"

#: templates/eos_invoices/index.html:94
msgid "Paid"
msgstr "已付"

#: templates/eos_invoices/index.html:96
msgid "Open"
msgstr "未付"

#: templates/eos_invoices/index.html:108
#: templates/eos_invoices/sources.html:76
msgid "No payment sources are configured."
msgstr "尚未配置款项来源。"

#: templates/eos_invoices/partials/copy-button.html:6
msgid "Copy"
msgstr "复制"

#: templates/eos_invoices/settings.html:19
#: templates/eos_invoices/source_form.html:51
msgid "Save"
msgstr "保存"

#: templates/eos_invoices/source_form.html:10
#: templates/eos_invoices/sources.html:10
msgid "Add source"
msgstr "添加来源"

#: templates/eos_invoices/source_form.html:29
msgid "Fields"
msgstr "字段"

#: templates/eos_invoices/source_form.html:31
msgid ""
"Field names of the chosen model. Related models are reached with a double "
"underscore, as in a Django query."
msgstr "所选模型的字段名。与 Django 查询相同，用双下划线访问关联模型。"

#: templates/eos_invoices/source_form.html:43
msgid "Display"
msgstr "显示"

#: templates/eos_invoices/source_form.html:52
msgid "Cancel"
msgstr "取消"

#: templates/eos_invoices/sources.html:16
msgid ""
"Each source is a model of another app with one row per payment a Corporation"
" owes. The overview reads every enabled source for the Corporation of the "
"viewer's main character."
msgstr ""
"每个来源都是另一个应用的模型，每行代表一笔 Corporation 应付的款项。概览会读取所有已启用的来源，针对查看者 Main 角色所在的 "
"Corporation。"

#: templates/eos_invoices/sources.html:40
msgid "Disabled"
msgstr "已停用"

#: templates/eos_invoices/sources.html:50
#, python-format
msgid "%(counter)s row"
msgid_plural "%(counter)s rows"
msgstr[0] "%(counter)s 行"

#: templates/eos_invoices/sources.html:63
#, python-format
msgid "Delete %(name)s?"
msgstr "删除 %(name)s？"

#: views.py:58
#, python-format
msgid "Saved %(name)s."
msgstr "已保存 %(name)s。"

#: views.py:95
#, python-format
msgid "Deleted %(name)s."
msgstr "已删除 %(name)s。"

#: views.py:108
msgid "Settings saved."
msgstr "设置已保存。"
